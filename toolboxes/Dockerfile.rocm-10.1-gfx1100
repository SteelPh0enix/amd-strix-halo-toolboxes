# ROCm 10.1 + baseline llama.cpp for desktop RDNA3 (gfx1100: RX 7900 XT / XTX / GRE).
# No Strix Halo patches, no iGPU workarounds.
#
# build stage
FROM registry.fedoraproject.org/fedora:44 AS builder

# ROCm 10.1 Core SDK repository (TheRock release stream)
RUN <<'EOF'
tee /etc/yum.repos.d/rocm.repo <<REPO
[amdrocm-stable]
name=ROCm 10.1.0
baseurl=https://stable.repo.amd.com/rocm/core/packages/rhel10/x86_64
enabled=1
priority=50
gpgcheck=1
gpgkey=https://stable.repo.amd.com/rocm/gpg/packages.gpg
REPO
EOF

# AMD's gfx1100 development meta-package: HIP, LLVM, and the hipBLAS/rocBLAS
# development files, including the gfx1100 GEMM kernel set.
RUN dnf -y --nodocs --setopt=install_weak_deps=False \
  install \
  make gcc gcc-c++ cmake ninja-build libcurl-devel rdma-core-devel \
  amdrocm-core-devel10.1-gfx1100 \
  git-core vim sudo rsync \
  && dnf clean all && rm -rf /var/cache/dnf/*

ENV ROCM_PATH=/opt/rocm \
  HIP_PATH=/opt/rocm \
  PATH=/opt/rocm/bin:/opt/rocm/core/bin:/opt/rocm/core/lib/llvm/bin:$PATH \
  LD_LIBRARY_PATH=/opt/rocm/core/lib/rocm_sysdeps/lib:/opt/rocm/core/lib

# llama.cpp (upstream, unpatched)
WORKDIR /opt/llama.cpp
ARG REPO=https://github.com/ggml-org/llama.cpp.git
ARG BRANCH=master
RUN git clone -b ${BRANCH} --single-branch --recursive ${REPO} .

# GPU_TARGET: the RDNA3 ISA of the card. Keep it to a single target, a fat
# binary only costs build time here.
# CPU_ARCH: explicit Zen 3 tuning. GGML_NATIVE stays OFF so that the image does
# not bake in the instruction set of whatever machine built it.
# FA_QUANTS: FlashAttention K/V types to compile. f16-f16 is always compiled.
ARG GPU_TARGET=gfx1100
ARG CPU_ARCH=znver3
ARG FA_QUANTS=f16-f16;q8_0-q8_0;q8_0-f16;f16-q8_0

RUN cmake -S . -B build -G Ninja \
  -DGGML_HIP=ON \
  -DGPU_TARGETS=${GPU_TARGET} \
  -DCMAKE_BUILD_TYPE=Release \
  -DGGML_RPC=ON \
  -DGGML_HIP_GRAPHS=ON \
  -DGGML_CUDA_FA=ON \
  -DGGML_CUDA_FA_QUANTS="${FA_QUANTS}" \
  -DGGML_NATIVE=OFF \
  -DCMAKE_C_FLAGS="-march=${CPU_ARCH}" \
  -DCMAKE_CXX_FLAGS="-march=${CPU_ARCH}" \
  -DROCM_PATH=/opt/rocm \
  -DHIP_PLATFORM=amd \
  && cmake --build build -- -j$(nproc) \
  && cmake --install build

# libs
RUN mkdir -p /usr/local/lib64 \
  && find /opt/llama.cpp/build -type f -name 'lib*.so*' -exec cp {} /usr/local/lib64/ \; \
  && ldconfig

# runtime stage
FROM registry.fedoraproject.org/fedora-minimal:44

RUN <<'EOF'
tee /etc/yum.repos.d/rocm.repo <<REPO
[amdrocm-stable]
name=ROCm 10.1.0
baseurl=https://stable.repo.amd.com/rocm/core/packages/rhel10/x86_64
enabled=1
priority=50
gpgcheck=1
gpgkey=https://stable.repo.amd.com/rocm/gpg/packages.gpg
REPO
EOF

# amdrocm10.1-gfx1100 pulls the HIP runtime, hipBLAS/rocBLAS, the gfx1100 GEMM
# kernels, and amd-smi, without the developer tools.
RUN microdnf -y --nodocs --setopt=install_weak_deps=0 \
  install \
  bash ca-certificates libatomic libstdc++ libgcc libgomp libibverbs libcurl sudo \
  amdrocm10.1-gfx1100 \
  radeontop procps-ng \
  && microdnf clean all && rm -rf /var/cache/dnf/* \
  && ln -s core-10.1 /opt/rocm/core \
  && ln -s core-10.1/bin /opt/rocm/bin \
  && ln -s core-10.1/include /opt/rocm/include \
  && ln -s core-10.1/lib /opt/rocm/lib \
  && ln -s core-10.1/libexec /opt/rocm/libexec \
  && ln -s core-10.1/lib/llvm /opt/rocm/llvm \
  && ln -s core-10.1/share /opt/rocm/share \
  && ln -s core-10.1/lib/llvm/amdgcn /opt/rocm/amdgcn

ENV ROCM_PATH=/opt/rocm \
  HIP_PATH=/opt/rocm \
  PATH=/opt/rocm/bin:/opt/rocm/core/bin:/opt/rocm/core/lib/llvm/bin:$PATH \
  LD_LIBRARY_PATH=/opt/rocm/core/lib/rocm_sysdeps/lib:/opt/rocm/core/lib

COPY --from=builder /usr/local/ /usr/local/
COPY --from=builder /opt/llama.cpp/build/bin/ggml-rpc-* /usr/local/bin/

RUN echo "/usr/local/lib" > /etc/ld.so.conf.d/local.conf \
  && echo "/usr/local/lib64" >> /etc/ld.so.conf.d/local.conf \
  && echo "/opt/rocm/core/lib" > /etc/ld.so.conf.d/rocm.conf \
  && echo "/opt/rocm/core/lib/rocm_sysdeps/lib" >> /etc/ld.so.conf.d/rocm.conf \
  && ldconfig \
  && find /usr/local/lib /usr/local/lib64 -maxdepth 1 -type f -name 'libllama*.so*' \
     -exec cp -n {} /usr/lib64/ \; \
  && ldconfig

CMD ["/bin/bash"]
